rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profils utilisateur : lecture ouverte aux comptes connectés (le
    // prénom doit pouvoir s'afficher chez un proche), écriture réservée au
    // propriétaire.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Relations : lisibles/modifiables seulement par les personnes qui en
    // font partie. La création est ouverte à tout compte connecté (il crée
    // une invitation où il est le seul membre) ; rejoindre une invitation
    // passe par une mise à jour, autorisée tant que le nouveau membre est
    // bien le requérant.
    match /relationships/{relationshipId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null &&
        request.resource.data.memberUids == [request.auth.uid];
      allow update: if request.auth != null &&
        request.auth.uid in request.resource.data.memberUids;
    }

    // Sessions Présence : lisibles/modifiables seulement par les deux
    // participants.
    match /presenceSessions/{sessionId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantUids;
    }

    // Compagnons : lecture ouverte (rien de sensible à afficher), écriture
    // réservée au propriétaire (perso) ou aux deux membres de la relation
    // (compagnon commun).
    match /companions/{companionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        (resource.data.ownerType == 'user' && resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerType == 'relationship' &&
          request.auth.uid in get(/databases/$(database)/documents/relationships/$(resource.data.ownerId)).data.memberUids)
      );
      // Autorise aussi la création initiale par le futur propriétaire.
      allow create: if request.auth != null &&
        (request.resource.data.ownerType != 'user' || request.resource.data.ownerId == request.auth.uid);
    }

    // Inventaire de cosmétiques : strictement privé à chaque utilisateur.
    match /inventory/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Souvenirs : lisibles/modifiables seulement par les membres de la
    // relation concernée.
    match /memories/{memoryId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/relationships/$(resource.data.relationshipId)).data.memberUids;
      allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/relationships/$(request.resource.data.relationshipId)).data.memberUids;
    }
  }
}
